  },
  "devDependencies": {
    "@gradestar/testing": "*",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
