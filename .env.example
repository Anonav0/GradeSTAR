# ==============================================================================
# GradeSTAR Environment Configuration Template
# Copy this file to .env before starting the services locally.
# ==============================================================================

# Node Environment: development | test | production
NODE_ENV=development

# Service Ports
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4001
POSTGRES_PORT=5433
REDIS_PORT=6379

# Logging
# Levels: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://gradestar:gradestar_dev_secret@localhost:5433/gradestar?schema=public

# Queue & Cache (Redis)
# Format: redis://[host]:[port]
REDIS_URL=redis://localhost:6379

# API URL (used by Frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

